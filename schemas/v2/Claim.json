{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "hypothesis_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hypothesis Id"
    },
    "criterion_ids": {
      "items": {
        "type": "string"
      },
      "title": "Criterion Ids",
      "type": "array"
    },
    "assessment_scope": {
      "default": "unbound_legacy",
      "enum": [
        "unbound_legacy",
        "criterion_bound"
      ],
      "title": "Assessment Scope",
      "type": "string"
    },
    "claim_id": {
      "title": "Claim Id",
      "type": "string"
    },
    "experiment_id": {
      "title": "Experiment Id",
      "type": "string"
    },
    "statement": {
      "title": "Statement",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "confidence": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "status": {
      "default": "UNVERIFIED",
      "enum": [
        "SUPPORTED",
        "REFUTED",
        "INCONCLUSIVE",
        "UNVERIFIED"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "experiment_id",
    "statement"
  ],
  "title": "Claim",
  "type": "object"
}
