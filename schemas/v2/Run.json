{
  "$defs": {
    "EnvironmentSpec": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "backend": {
          "default": "docker",
          "minLength": 1,
          "title": "Backend",
          "type": "string"
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "python:3.12-slim",
          "title": "Image"
        },
        "settings": {
          "additionalProperties": true,
          "title": "Settings",
          "type": "object"
        },
        "cpu": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Cpu",
          "type": "number"
        },
        "memory_gb": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Memory Gb",
          "type": "number"
        },
        "dependencies": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "object"
        },
        "network": {
          "const": "disabled",
          "default": "disabled",
          "title": "Network",
          "type": "string"
        }
      },
      "title": "EnvironmentSpec",
      "type": "object"
    },
    "PolicyIdentity": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "policy_id": {
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "checkpoint_id": {
          "minLength": 1,
          "title": "Checkpoint Id",
          "type": "string"
        },
        "training_step": {
          "minimum": 0,
          "title": "Training Step",
          "type": "integer"
        },
        "rollout_batch_id": {
          "minLength": 1,
          "title": "Rollout Batch Id",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "policy_version",
        "checkpoint_id",
        "training_step",
        "rollout_batch_id"
      ],
      "title": "PolicyIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "trajectory_source": {
      "default": "OFFLINE",
      "enum": [
        "OFFLINE",
        "ONLINE_RL",
        "REPLAY",
        "BRANCH"
      ],
      "title": "Trajectory Source",
      "type": "string"
    },
    "policy_identity": {
      "anyOf": [
        {
          "$ref": "#/$defs/PolicyIdentity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "experiment_id": {
      "title": "Experiment Id",
      "type": "string"
    },
    "hypothesis_ids": {
      "items": {
        "type": "string"
      },
      "title": "Hypothesis Ids",
      "type": "array"
    },
    "environment_snapshot_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Environment Snapshot Id"
    },
    "environment_handle": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Environment Handle"
    },
    "environment_spec": {
      "$ref": "#/$defs/EnvironmentSpec"
    },
    "code_version": {
      "title": "Code Version",
      "type": "string"
    },
    "config": {
      "additionalProperties": true,
      "title": "Config",
      "type": "object"
    },
    "seed": {
      "default": 0,
      "title": "Seed",
      "type": "integer"
    },
    "resource_spec": {
      "additionalProperties": true,
      "title": "Resource Spec",
      "type": "object"
    },
    "status": {
      "default": "RUNNING",
      "enum": [
        "RUNNING",
        "COMPLETED",
        "FAILED"
      ],
      "title": "Status",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "parent_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Run Id"
    },
    "parent_step_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Step Id"
    },
    "trajectory_id": {
      "title": "Trajectory Id",
      "type": "string"
    }
  },
  "required": [
    "experiment_id",
    "environment_spec",
    "code_version"
  ],
  "title": "Run",
  "type": "object"
}
