      "title": "Verification Id",
      "type": "string"
    },
    "experiment_id": {
      "title": "Experiment Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "verifier": {
      "title": "Verifier",
      "type": "string"
    },
    "status": {
      "enum": [
