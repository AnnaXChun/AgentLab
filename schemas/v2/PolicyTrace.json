  "required": [
    "policy_id",
    "policy_version",
    "checkpoint_id",
    "training_step",
    "rollout_batch_id",
    "experiment_id",
    "run_id",
    "trajectory_id",
    "prompt_token_ids",
    "response_token_ids",
    "response_mask",
    "step_spans",
    "sampling_params"
  ],
  "title": "PolicyTrace",
  "type": "object"
}
