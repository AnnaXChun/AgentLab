      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "policy_id": {
      "minLength": 1,
      "title": "Policy Id",
      "type": "string"
    },
    "policy_version": {
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "checkpoint_id": {
      "minLength": 1,
      "title": "Checkpoint Id",
      "type": "string"
    },
    "training_step": {
      "minimum": 0,
      "title": "Training Step",
      "type": "integer"
    },
    "rollout_batch_id": {
      "minLength": 1,
      "title": "Rollout Batch Id",
      "type": "string"
    },
    "policy_trace_id": {
      "title": "Policy Trace Id",
      "type": "string"
    },
    "experiment_id": {
      "title": "Experiment Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "trajectory_id": {
      "title": "Trajectory Id",
      "type": "string"
    },
    "trajectory_source": {
      "default": "ONLINE_RL",
      "enum": [
        "OFFLINE",
        "ONLINE_RL",
        "REPLAY",
        "BRANCH"
      ],
      "title": "Trajectory Source",
      "type": "string"
    },
    "prompt_token_ids": {
      "items": {
        "type": "integer"
      },
      "title": "Prompt Token Ids",
      "type": "array"
    },
    "response_token_ids": {
      "items": {
        "type": "integer"
      },
      "title": "Response Token Ids",
      "type": "array"
    },
    "response_mask": {
      "items": {
        "enum": [
          0,
          1
        ],
        "type": "integer"
      },
      "title": "Response Mask",
      "type": "array"
    },
    "response_logprobs": {
      "anyOf": [
        {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
