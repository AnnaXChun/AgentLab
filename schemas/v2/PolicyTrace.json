          "type": "string"
        },
        "trajectory_step_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trajectory Step Id"
        },
        "response_token_start": {
          "title": "Response Token Start",
          "type": "integer"
        },
        "response_token_end": {
          "title": "Response Token End",
          "type": "integer"
        },
        "action_token_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Token Start"
        },
        "action_token_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Token End"
        },
        "tool_response_token_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Response Token Start"
        },
        "tool_response_token_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
