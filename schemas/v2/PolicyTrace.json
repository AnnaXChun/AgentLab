      "default": null,
      "title": "Response Logprobs"
    },
    "step_spans": {
      "items": {
        "$ref": "#/$defs/PolicyStepSpan"
      },
      "title": "Step Spans",
      "type": "array"
    },
    "sampling_params": {
      "additionalProperties": true,
      "title": "Sampling Params",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
