{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "backend": {
      "default": "docker",
      "minLength": 1,
      "title": "Backend",
      "type": "string"
    },
    "image": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "python:3.12-slim",
      "title": "Image"
    },
    "settings": {
      "additionalProperties": true,
      "title": "Settings",
      "type": "object"
    },
    "cpu": {
      "default": 1,
      "exclusiveMinimum": 0,
      "title": "Cpu",
      "type": "number"
    },
    "memory_gb": {
      "default": 1,
      "exclusiveMinimum": 0,
      "title": "Memory Gb",
      "type": "number"
    },
    "dependencies": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Dependencies",
      "type": "object"
    },
    "network": {
      "const": "disabled",
      "default": "disabled",
      "title": "Network",
      "type": "string"
    }
  },
  "title": "EnvironmentSpec",
  "type": "object"
}
