        "hypothesis.registered",
        "run.started",
        "run.finished",
        "action.requested",
        "observation.recorded",
        "trajectory.recorded",
        "object.recorded",
        "environment.operation",
        "evidence.generated",
        "claim.assessed",
        "counterfactual.linked",
        "replay.result",
        "episode.started",
        "episode.completed",
        "episode.failed",
        "agent.message",
        "agent.action",
        "retrieval.ingest",
        "retrieval.ingested",
        "retrieval.query",
        "retrieval.result",
        "tool.call",
        "tool.result",
        "sandbox.command",
        "sandbox.result",
        "artifact.created",
        "claim.created",
        "claim.updated",
        "verification.started",
        "verification.result",
        "checkpoint.created",
        "branch.created",
        "rollback.created",
        "budget.updated",
        "export.started",
        "export.completed"
