      "title": "Schema Version",
      "type": "string"
    },
    "episode_id": {
      "title": "Episode Id",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "sequence": {
      "default": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "trace_id": {
      "default": "",
      "title": "Trace Id",
      "type": "string"
    },
    "span_id": {
      "default": "",
      "title": "Span Id",
      "type": "string"
    },
    "branch_id": {
      "title": "Branch Id",
      "type": "string"
    },
    "parent_event_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Event Id"
    },
    "actor_type": {
      "default": "harness",
      "title": "Actor Type",
      "type": "string"
    },
    "actor_id": {
      "default": "scientific-harness",
      "title": "Actor Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/EventType"
    },
    "input": {
      "additionalProperties": true,
      "title": "Input",
      "type": "object"
    },
    "output": {
      "additionalProperties": true,
      "title": "Output",
      "type": "object"
    },
    "artifact_refs": {
      "items": {
        "type": "string"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "state_before_hash": {
      "default": "",
      "title": "State Before Hash",
      "type": "string"
    },
    "state_after_hash": {
      "default": "",
      "title": "State After Hash",
      "type": "string"
    },
    "status": {
      "default": "SUCCESS",
      "enum": [
        "PENDING",
        "SUCCESS",
        "FAILED"
      ],
      "title": "Status",
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "episode_id",
    "branch_id",
    "event_type"
  ],
  "title": "Event",
  "type": "object"
}
